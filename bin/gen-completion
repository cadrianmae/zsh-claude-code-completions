#!/usr/bin/env python3
"""Generate a zsh completion function for the Claude Code CLI.

The CLI is built on commander.js, whose --help output is regular enough to
parse: an Options: block, an optional Commands: block, and value constraints
spelled out inline as (choices: "a", "b").

Commander wraps its output to the terminal width and ignores $COLUMNS when
stdout is not a TTY, hard-wrapping at 80 columns instead. Descriptions then
straddle several lines and flag specs become ambiguous. We therefore run the
CLI under a pty sized to WIDTH columns so each entry stays on one line.

Usage:
    gen-completion [--claude PATH] [--output FILE] [--depth N]
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import pty
import re
import struct
import subprocess
import sys
import termios
from dataclasses import dataclass, field
from pathlib import Path

# Wide enough that commander never wraps an option entry. Overshooting is
# free; undershooting silently reintroduces the wrapping we are avoiding.
WIDTH = 400
HEIGHT = 50

# Descriptions in the help output run to full paragraphs. zsh shows these in
# a one-line menu, so keep the first sentence and cap the length.
DESC_MAX = 90

# `help` is commander's built-in and completing it adds nothing.
SKIP_COMMANDS = {"help"}


# --------------------------------------------------------------------------
# Running the CLI
# --------------------------------------------------------------------------


def run_help(argv: list[str]) -> str:
    """Return the --help output of argv, captured through a wide pty."""
    master, slave = pty.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", HEIGHT, WIDTH, 0, 0))
    try:
        proc = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=slave,
            stderr=slave,
            close_fds=True,
        )
    except OSError as exc:
        os.close(master)
        os.close(slave)
        raise SystemExit(f"cannot run {argv[0]}: {exc}")

    os.close(slave)
    chunks: list[bytes] = []
    while True:
        try:
            data = os.read(master, 65536)
        except OSError:  # pty closed by the child exiting
            break
        if not data:
            break
        chunks.append(data)
    os.close(master)
    proc.wait()

    text = b"".join(chunks).decode("utf-8", "replace")
    return text.replace("\r\n", "\n").replace("\r", "")


def claude_version(claude: str) -> str:
    out = subprocess.run(
        [claude, "--version"], capture_output=True, text=True, check=False
    ).stdout
    match = re.search(r"\d+\.\d+\.\d+", out)
    return match.group(0) if match else "unknown"


# --------------------------------------------------------------------------
# Parsing
# --------------------------------------------------------------------------


@dataclass
class Option:
    flags: list[str]  # e.g. ["-p", "--print"]
    arg: str | None  # metavariable name, without brackets
    required_arg: bool  # <arg> rather than [arg]
    variadic: bool  # trailing ... in the metavariable
    desc: str
    choices: list[str] = field(default_factory=list)


@dataclass
class Command:
    name: str  # canonical name
    aliases: list[str]
    desc: str
    options: list[Option] = field(default_factory=list)
    subcommands: list["Command"] = field(default_factory=list)


# "  -p, --print" / "  --allowedTools, --allowed-tools <tools...>", followed by
# either two-or-more spaces and the description, or a wrapped description on
# the next line when the flag column overflows.
OPTION_RE = re.compile(r"^ {2}(?P<flags>-{1,2}\S[^\s].*?)(?: {2,}(?P<desc>\S.*))?$")

# "  add-json [options] <name> <json>          Add an MCP server ..."
COMMAND_RE = re.compile(
    r"^ {2}(?P<name>[a-zA-Z][\w-]*(?:\|[\w-]+)*)"
    r"(?P<args>(?: \[options\]| <[^>]+>| \[[^\]]+\])*)"
    r" {2,}(?P<desc>\S.*)$"
)

CHOICES_RE = re.compile(r"\(choices:\s*(?P<body>.*?)\)(?:\s|$)")
QUOTED_RE = re.compile(r'"([^"]*)"')


def split_sections(text: str) -> dict[str, list[str]]:
    """Split help output into its `Foo:` sections, keeping raw lines."""
    sections: dict[str, list[str]] = {}
    current: str | None = None
    for line in text.split("\n"):
        header = re.match(r"^(\w[\w ]*):$", line)
        if header:
            current = header.group(1)
            sections[current] = []
        elif current is not None:
            sections[current].append(line)
    return sections


def clean_desc(desc: str) -> str:
    """Collapse a wrapped description into one short menu-friendly line."""
    desc = re.sub(r"\s+", " ", desc).strip()
    # Drop the trailing metadata commander appends; it is noise in a menu.
    desc = re.sub(r"\s*\((?:default|choices|preset):.*$", "", desc)
    if len(desc) > DESC_MAX:
        cut = desc.find(". ")
        desc = desc[:cut] if 0 < cut <= DESC_MAX else desc[:DESC_MAX].rstrip() + "..."
    return desc.rstrip(".").strip()


def parse_choices(desc: str) -> list[str]:
    """Extract the values from commander's `(choices: "a", "b", preset: "a")`."""
    match = CHOICES_RE.search(desc)
    if not match:
        return []
    body = match.group("body").split(", preset:")[0]
    return QUOTED_RE.findall(body)


def parse_option_flags(spec: str) -> tuple[list[str], str | None, bool, bool]:
    """Split "-d, --debug [filter]" into flags plus metavariable details."""
    arg = None
    required = False
    variadic = False

    meta = re.search(r"[<\[]([^>\]]+)[>\]]\s*$", spec)
    if meta:
        arg = meta.group(1)
        required = spec[meta.start()] == "<"
        spec = spec[: meta.start()].strip()
    if arg and arg.endswith("..."):
        variadic = True
        arg = arg[:-3]

    flags = [f.strip() for f in spec.split(",") if f.strip().startswith("-")]
    return flags, arg, required, variadic


def parse_options(lines: list[str]) -> list[Option]:
    """Parse an Options: section into Option records."""
    options: list[Option] = []
    pending_flags: str | None = None
    pending_desc: list[str] = []

    def flush() -> None:
        nonlocal pending_flags, pending_desc
        if pending_flags is None:
            return
        raw_desc = " ".join(pending_desc)
        flags, arg, required, variadic = parse_option_flags(pending_flags)
        if flags:
            options.append(
                Option(
                    flags=flags,
                    arg=arg,
                    required_arg=required,
                    variadic=variadic,
                    desc=clean_desc(raw_desc),
                    choices=parse_choices(raw_desc),
                )
            )
        pending_flags, pending_desc = None, []

    for line in lines:
        if not line.strip():
            continue
        match = OPTION_RE.match(line)
        if match:
            flush()
            pending_flags = match.group("flags").strip()
            pending_desc = [match.group("desc")] if match.group("desc") else []
        elif pending_flags is not None and line.startswith("  "):
            # Continuation of the previous entry's description.
            pending_desc.append(line.strip())
    flush()
    return options


def parse_commands(lines: list[str]) -> list[tuple[str, list[str], str]]:
    """Parse a Commands: section into (name, aliases, description) tuples.

    Some entries embed multi-line examples in their description. Those lines
    are either blank, indented past the command column, or lack the two-space
    description separator, so COMMAND_RE rejects them.
    """
    found: list[tuple[str, list[str], str]] = []
    for line in lines:
        match = COMMAND_RE.match(line)
        if not match:
            continue
        names = match.group("name").split("|")
        name, aliases = names[0], names[1:]
        if name in SKIP_COMMANDS:
            continue
        found.append((name, aliases, clean_desc(match.group("desc"))))
    return found


def build_tree(claude: str, path: list[str], depth: int) -> Command:
    """Recursively walk `claude <path> --help` into a Command tree."""
    label = " ".join(path) if path else "claude"
    print(f"  probing: {label}", file=sys.stderr)

    sections = split_sections(run_help([claude, *path, "--help"]))
    command = Command(
        name=path[-1] if path else "claude",
        aliases=[],
        desc="",
        options=parse_options(sections.get("Options", [])),
    )
    if depth <= 0:
        return command

    for name, aliases, desc in parse_commands(sections.get("Commands", [])):
        child = build_tree(claude, [*path, name], depth - 1)
        child.name, child.aliases, child.desc = name, aliases, desc
        command.subcommands.append(child)
    return command


# --------------------------------------------------------------------------
# Emitting zsh
# --------------------------------------------------------------------------


def zq(text: str) -> str:
    """Quote text for use inside a single-quoted zsh word."""
    return text.replace("'", "'\\''")


def zbracket(text: str) -> str:
    """Escape the characters _arguments treats as spec syntax."""
    return (
        text.replace("\\", "\\\\")
        .replace("[", "\\[")
        .replace("]", "\\]")
        .replace(":", "\\:")
    )


def func_name(path: list[str]) -> str:
    return "_claude_" + "_".join(p.replace("-", "_") for p in path) if path else "_claude"


def lookup_override(overrides: dict, path: list[str], flag: str) -> dict | None:
    """Find an override for flag, preferring one qualified by command path."""
    options = overrides.get("options", {})
    for depth in range(len(path), -1, -1):
        prefix = " ".join(path[:depth])
        key = f"{prefix}:{flag}" if prefix else flag
        if key in options:
            return options[key]
    return None


def action_for(option: Option, override: dict | None) -> str:
    """Choose the completion action for an option's argument."""
    if override:
        if "action" in override:
            return override["action"]
        if "choices" in override:
            return "(" + " ".join(zq(c) for c in override["choices"]) + ")"
    if option.choices:
        return "(" + " ".join(zq(c) for c in option.choices) + ")"

    arg = (option.arg or "").lower()
    if "dir" in arg:
        return "_files -/"
    if any(word in arg for word in ("file", "path", "schema")):
        return "_files"
    return " "  # no candidates; let the user type freely


def option_specs(options: list[Option], path: list[str], overrides: dict) -> list[str]:
    """Render Option records as _arguments specs."""
    specs: list[str] = []
    for option in options:
        desc = zbracket(option.desc)

        # Flags that repeat meaningfully get '*'; the rest are single-use, and
        # listing the alternatives in (...) stops zsh offering a synonym of a
        # flag already on the line.
        exclusive = "(" + " ".join(option.flags) + ")" if len(option.flags) > 1 else ""
        prefix = "*" if option.variadic else exclusive

        override = next(
            (o for f in option.flags if (o := lookup_override(overrides, path, f))),
            None,
        )

        for flag in option.flags:
            if option.arg:
                joiner = ":" if option.required_arg else "::"
                action = action_for(option, override)
                body = f"{flag}[{desc}]{joiner}{zbracket(option.arg)}:{action}"
            else:
                body = f"{flag}[{desc}]"
            specs.append(f"'{prefix}{zq(body)}'")
            if not option.variadic and len(option.flags) > 1:
                # The exclusion list is emitted once per flag, so later flags
                # need no further prefix.
                prefix = exclusive
    return specs


def emit_command(
    path: list[str], command: Command, out: list[str], overrides: dict
) -> None:
    """Emit a completion function for command, then one per subcommand."""
    name = func_name(path)
    specs = option_specs(command.options, path, overrides)

    positional = overrides.get("positionals", {}).get(" ".join(path))
    if positional and not command.subcommands:
        specs.append(f"'1: :{zq(positional)}'")

    if command.subcommands:
        descriptions = []
        for sub in command.subcommands:
            for label in [sub.name, *sub.aliases]:
                descriptions.append(f"    '{zq(label)}:{zq(zbracket(sub.desc))}'")

        out.append(f"{name}_commands() {{")
        out.append("  local -a commands")
        out.append("  commands=(")
        out.extend(descriptions)
        out.append("  )")
        out.append(f"  _describe -t commands '{zq(' '.join(path) or 'claude')} command' commands")
        out.append("}")
        out.append("")

        specs.append("'1: :" + name + "_commands'")
        specs.append("'*:: :->subcommand'")

    out.append(f"{name}() {{")
    out.append('  local curcontext="$curcontext" state line ret=1')
    out.append("  typeset -A opt_args")
    out.append("")
    out.append("  _arguments -C -s -S \\")
    for index, spec in enumerate(specs):
        tail = " \\" if index < len(specs) - 1 else " && ret=0"
        out.append(f"    {spec}{tail}")

    if command.subcommands:
        out.append("")
        out.append('  case "$state" in')
        out.append("    subcommand)")
        out.append('      case "$words[1]" in')
        for sub in command.subcommands:
            pattern = "|".join([sub.name, *sub.aliases])
            out.append(f"        {pattern}) {func_name([*path, sub.name])} && ret=0 ;;")
        out.append("      esac")
        out.append("      ;;")
        out.append("  esac")

    out.append("")
    out.append("  return ret")
    out.append("}")
    out.append("")

    for sub in command.subcommands:
        emit_command([*path, sub.name], sub, out, overrides)


def emit(root: Command, version: str, overrides: dict, helpers: str) -> str:
    out = [
        "#compdef claude",
        "",
        "# zsh completion for the Claude Code CLI.",
        "#",
        f"# Generated by bin/gen-completion from claude {version} --help.",
        "# Do not edit by hand; edit overrides.json or helpers.zsh and",
        "# run `just generate`.",
        "",
    ]
    if helpers:
        out.append(helpers.rstrip())
        out.append("")
    emit_command([], root, out, overrides)
    out.append('_claude "$@"')
    out.append("")
    return "\n".join(out)


# --------------------------------------------------------------------------


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--claude", default="claude", help="path to the claude binary")
    parser.add_argument("--output", default="_claude", help="output file, or - for stdout")
    parser.add_argument(
        "--depth", type=int, default=3, help="how many levels of subcommands to walk"
    )
    parser.add_argument(
        "--version-file",
        default="claude-version",
        help="file to record the CLI version in ('' to skip)",
    )
    here = Path(__file__).resolve().parent.parent
    parser.add_argument("--overrides", default=str(here / "overrides.json"))
    parser.add_argument("--helpers", default=str(here / "helpers.zsh"))
    args = parser.parse_args()

    overrides = {}
    if args.overrides and os.path.exists(args.overrides):
        with open(args.overrides) as handle:
            overrides = json.load(handle)

    helpers = ""
    if args.helpers and os.path.exists(args.helpers):
        helpers = Path(args.helpers).read_text()

    version = claude_version(args.claude)
    print(f"claude {version}", file=sys.stderr)

    root = build_tree(args.claude, [], args.depth)
    script = emit(root, version, overrides, helpers)

    if args.output == "-":
        sys.stdout.write(script)
    else:
        with open(args.output, "w") as handle:
            handle.write(script)
        print(f"wrote {args.output}", file=sys.stderr)
        if args.version_file:
            with open(args.version_file, "w") as handle:
                handle.write(version + "\n")

    count = len(root.options)
    subs = len(root.subcommands)
    print(f"{count} top-level options, {subs} subcommands", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
